  {
    "number": 2,
    "title": "太阳不等答案",
    "en": "The Sun Won’t Wait for an Answer",
    "verse": "大道无情，运行日月。",
    "image": "assets/episode-02.webp",
    "thumb": "assets/thumb-02.webp",
    "width": 1024,
    "height": 1536,
    "source_filename": "exec-6f26eb69-2b82-44e5-b6a6-ef0be2b23ac2.png"
  },
  {
    "number": 3,
    "title": "我们算什么？",
    "en": "What Are We?",
    "verse": "大道无名，长养万物。吾不知其名，强名曰道。",
    "image": "assets/episode-03.webp",
    "thumb": "assets/thumb-03.webp",
    "width": 1024,
    "height": 1536,
    "source_filename": "exec-0ba8de5c-44ef-45a4-8c83-469ee620bde2.png"
  },
  {
    "number": 4,
    "title": "别替我写好角色",
    "en": "Don’t Cast Me in a Role",
    "verse": "夫道者：有清有浊，有动有静。",
    "image": "assets/episode-04.webp",
    "thumb": "assets/thumb-04.webp",
    "width": 1024,
    "height": 1536,
    "source_filename": "exec-c1f97918-7df7-4c76-85d3-258779cb44b7.png"
  },
  {
    "number": 5,
    "title": "搅浑的那杯水",
    "en": "Stirring the Water",
    "verse": "清者浊之源，动者静之基。",
    "image": "assets/episode-05.webp",
    "thumb": "assets/thumb-05.webp",
    "width": 1024,
    "height": 1536,
    "source_filename": "exec-ec2dd1cf-56ca-46ab-89de-0072cfc4d021.png"
  },
  {
    "number": 6,
    "title": "她为什么还没回复？",
    "en": "Why Hasn’t She Replied?",
    "verse": "夫人神好清，而心扰之；人心好静，而欲牵之。",
    "image": "assets/episode-06.webp",
    "thumb": "assets/thumb-06.webp",
    "width": 1024,
    "height": 1536,
    "source_filename": "exec-174190ed-df38-4138-acab-beb4bf68d905.png"
  },
  {
    "number": 7,
    "title": "想靠近，还是想占有？",
    "en": "Closeness or Possession?",
    "verse": "常能遣其欲，而心自静，澄其心而神自清。",
    "image": "assets/episode-07.webp",
    "thumb": "assets/thumb-07.webp",
    "width": 1024,
    "height": 1536,
    "source_filename": "exec-d804846c-4f5d-449c-9693-d3341a2df637.png"
  },
  {
    "number": 8,
    "title": "谁在嫉妒？",
    "en": "Who Is Feeling Jealous?",
    "verse": "内观其心，心无其心。",
    "image": "assets/episode-08.webp",
    "thumb": "assets/thumb-08.webp",
    "width": 1024,
    "height": 1536,
    "source_filename": "exec-572f8cf5-daf1-460c-afef-0328cf44a62c.png"
  },
  {
    "number": 9,
    "title": "换了模样，还是你吗？",
    "en": "Still You, in Another Form?",
    "verse": "外观其形，形无其形；远观其物，物无其物。",
    "image": "assets/episode-09.webp",
    "thumb": "assets/thumb-09.webp",
    "width": 1024,
    "height": 1536,
    "source_filename": "exec-b960aee9-d1ae-46a6-8bdd-8bf0022d8514.png"
  },
  {
    "number": 10,
    "title": "“我已经放下了”",
    "en": "“I’ve Already Let Go”",
    "verse": "三者既悟，唯见于空；观空亦空，空无所空。",
    "image": "assets/episode-10.webp",
    "thumb": "assets/thumb-10.webp",
    "width": 1024,
    "height": 1536,
    "source_filename": "exec-e4ec0712-8fa6-4f77-97b1-7f9d6233ceef.png"
  },
  {
    "number": 11,
    "title": "不必立刻想通",
    "en": "We Don’t Have to Figure It Out Tonight",
    "verse": "所空既无，无无亦无；无无既无，湛然常寂。",
    "image": "assets/episode-11.webp",
    "thumb": "assets/thumb-11.webp",
    "width": 1024,
    "height": 1536,
    "source_filename": "exec-d1f8e51d-a0c9-42bf-9e0c-a4c112cd5d76.png"
  },
  {
    "number": 12,
    "title": "温泉里的雨声",
    "en": "Rain at the Hot Springs",
    "verse": "真常应物，真常得性；常应常静，常清静矣。",
    "image": "assets/episode-12.webp",
    "thumb": "assets/thumb-12.webp",
    "width": 1024,
    "height": 1536,
    "source_filename": "exec-5b5fc432-b650-49e1-a80e-b3f343f5c1e5.png"
  },
  {
    "number": 13,
    "title": "没有“懂了”的奖章",
    "en": "Understanding Isn’t a Trophy",
    "verse": "如此清静，渐入真道；既入真道，名为得道，虽名得道，实无所得。",
    "image": "assets/episode-13.webp",
    "thumb": "assets/thumb-13.webp",
    "width": 1024,
    "height": 1536,
    "source_filename": "exec-183ae7d5-aa6b-4b34-9589-a3309e03c3e8.png"
  },
  {
    "number": 14,
    "title": "不争，也可以说喜欢",
    "en": "Love Needn’t Be a Contest",
    "verse": "上士无争，下士好争。",
    "image": "assets/episode-14.webp",
    "thumb": "assets/thumb-14.webp",
    "width": 1024,
    "height": 1536,
    "source_filename": "exec-aa8bad4f-61b0-4b18-9d0c-0c4b98bce41c.png"
  },
  {
    "number": 15,
    "title": "“我都是为你好”",
    "en": "“It’s All for Your Own Good”",
    "verse": "上德不德，下德执德。执著之者，不名道德。",
    "image": "assets/episode-15.webp",
    "thumb": "assets/thumb-15.webp",
    "width": 1024,
    "height": 1536,
    "source_filename": "exec-0e79d54b-b352-4b7c-b8a8-deb9686d6012.png"
  },
  {
    "number": 16,
    "title": "一张照片，三种故事",
    "en": "One Photo, Three Stories",
    "verse": "既有妄心，即惊其神；既惊其神，即著万物；既著万物，即生贪求；既生贪求，即是烦恼。",
    "image": "assets/episode-16.webp",
    "thumb": "assets/thumb-16.webp",
    "width": 1024,
    "height": 1536,
    "source_filename": "exec-cf1f1796-5f62-4c72-a1a9-daaf4a9bc46d.png"
  },
  {
    "number": 17,
    "title": "不能再用沉默拖延",
    "en": "No More Hiding in Silence",
    "verse": "烦恼妄想，忧苦身心，便遭浊辱，流浪生死，常沉苦海，永失真道。",
    "image": "assets/episode-17.webp",
    "thumb": "assets/thumb-17.webp",
    "width": 1024,
    "height": 1536,
    "source_filename": "exec-a2c72aaf-b670-452e-8323-10d89a61a635.png"
  },
  {
    "number": 18,
    "title": "海还在，心已从容",
    "en": "The Sea Remains, Our Hearts at Ease",
    "verse": "真常之道，悟者自得；得悟道者，常清静矣！",
    "image": "assets/episode-18.webp",
    "thumb": "assets/thumb-18.webp",
    "width": 1024,
    "height": 1536,
    "source_filename": "exec-d4138849-d471-4ab5-971f-e08976911bf0.png"
  }
]